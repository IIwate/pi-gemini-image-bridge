{
  "name": "pi-gemini-image-paste",
  "version": "0.2.0",
  "description": "Pi extension: bypass the broken read-tool image path for Gemini-family models by converting pasted clipboard images into user-message attachments.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "gemini",
    "image"
  ],
  "author": "IIwate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IIwate/pi-gemini-image-paste.git"
  },
  "bugs": {
    "url": "https://github.com/IIwate/pi-gemini-image-paste/issues"
  },
  "homepage": "https://github.com/IIwate/pi-gemini-image-paste#readme",
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
